# ---------------------------------------------------------------------------
# CA Marketing — environment variable reference
#
# Copy to `.env.local` and fill in real values. NEVER commit a filled-in file:
# `.gitignore` excludes every `.env*` except this example, and this repository
# is PUBLIC. Real values belong in Vercel → Project → Settings → Environment
# Variables, not in git.
# ---------------------------------------------------------------------------

# --- Supabase (required) ---------------------------------------------------
# Project URL and anon key are safe to expose to the browser (NEXT_PUBLIC_*).
# Both come from Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SECRET — bypasses Row Level Security entirely. Server-side only; `server-only`
# keeps it out of the client bundle. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Site ------------------------------------------------------------------
# Absolute origin, no trailing slash. Used for metadata, sitemap.xml, robots.txt.
# Defaults to http://localhost:3000 when unset.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# --- Email (optional) ------------------------------------------------------
# SECRET. Without it the app falls back to a console email provider that logs
# instead of sending, so local development works with this left blank.
RESEND_API_KEY=your-resend-api-key

# Verified sender. Defaults to "CA Marketing <hello@ca-marketing.example>".
EMAIL_FROM=CA Marketing <hello@your-domain.com>

# Inbox for new-lead notifications. Falls back to EMAIL_FROM when unset.
LEAD_NOTIFICATION_EMAIL=leads@your-domain.com

# --- n8n lead webhook (optional) -------------------------------------------
# When unset, lead dispatch no-ops and logs, so the consultation flow still
# succeeds without n8n configured.
N8N_LEAD_WEBHOOK_URL=https://your-n8n-instance/webhook/lead

# SECRET. Sent as the X-Webhook-Secret header so n8n can verify the caller.
N8N_WEBHOOK_SECRET=your-shared-webhook-secret
